{
  "name": "exyconn-app-boilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "pnpm --filter server dev",
    "dev:server:memory": "pnpm --filter server dev:memory",
    "dev:admin": "pnpm --filter admin-portal dev",
    "dev:mobile": "pnpm --filter mobile-app start",
    "codegen": "graphql-codegen --config codegen.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:mobile:coverage": "pnpm --filter mobile-app coverage",
    "coverage:check": "node scripts/check-coverage.mjs",
    "test:component": "pnpm --filter @common/shell cy:run",
    "test:e2e": "pnpm --filter admin-portal e2e",
    "build": "pnpm -r --workspace-concurrency=1 --if-present build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.3",
    "cypress": "^16.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "graphql": "^16.14.2",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.11.2"
}
