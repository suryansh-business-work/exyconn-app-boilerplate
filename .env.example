# Used by docker-compose.yml. Copy to .env on the server and fill in. Never commit real values.

# MongoDB root account, created the first time the database volume is initialised
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_DATABASE=app

# API server
NODE_ENV=staging
# Host port the API is published on
SERVER_PORT=4000
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=
# Comma-separated list of portal / mWeb origins allowed to call the API
CORS_ORIGINS=
# Number of reverse proxies in front of the server (0 when exposed directly)
TRUST_PROXY=1
LOG_LEVEL=info

# First admin account, created once at startup if it does not exist
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
