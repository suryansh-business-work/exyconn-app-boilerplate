{
  "name": "mobile-app",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@common/api": "workspace:*",
    "@common/auth": "workspace:*",
    "@common/design-tokens": "workspace:*",
    "@common/error-boundary": "workspace:*",
    "@common/error-handling": "workspace:*",
    "@common/localization": "workspace:*",
    "@common/regex": "workspace:*",
    "@common/types": "workspace:*",
    "@common/validators": "workspace:*",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@tamagui/config": "^3.0.3",
    "expo": "~57.0.28",
    "expo-constants": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-hook-form": "^7.90.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "tamagui": "^3.0.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "coverage": "jest --coverage"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/**/*.test.{ts,tsx}"
    ],
    "collectCoverageFrom": [
      "App.tsx",
      "src/**/*.{ts,tsx}",
      "../../packages/common/error-boundary/src/native/**/*.tsx",
      "!**/*.test.{ts,tsx}",
      "!**/*.types.tsx"
    ],
    "coverageReporters": [
      "lcov",
      "text-summary"
    ],
    "coverageDirectory": "coverage",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|tamagui|@tamagui/.*))"
    ],
    "transform": {
      ".mjs$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ],
          "caller": {
            "name": "metro",
            "bundler": "jest",
            "platform": "ios"
          }
        }
      ]
    },
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
