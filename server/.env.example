# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/boilerplate
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated list of portal / mWeb origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the server (0 when exposed directly)
TRUST_PROXY=0
LOG_LEVEL=info
# Requests allowed per client IP in each 15-minute window
RATE_LIMIT_GENERAL_MAX=600
RATE_LIMIT_AUTH_MAX=20
# First admin account, created once at startup if it does not exist
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
